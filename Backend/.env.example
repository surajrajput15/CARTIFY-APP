PORT=5000
MONGO_URI=your_mongodb_connection_string
# Email config (REQUIRED — one of the two paths must be set or the server will not start):
#   Option 1 (recommended for Render): Brevo transactional email API key
BREVO_API_KEY=your_brevo_api_key
#   Option 2 (local / Gmail SMTP fallback): Gmail address + app password
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# Sender address for transactional emails (defaults to EMAIL_USER if unset)
EMAIL_FROM=your_email@gmail.com
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
JWT_SECRET=your_jwt_secret_key
# Must be the SAME client ID as the frontend's VITE_GOOGLE_CLIENT_ID
# (verifyIdToken audience must match the OAuth client that issued the token)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
# Optional: Cloudinary for persistent image storage (recommended on Render, where
# the local disk is wiped on every restart). When unset, uploads fall back to the
# local /uploads folder (development only).
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
